# ─── Database ───
# MySQL connection string for Hostinger production
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# ─── Admin Authentication ───
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# ─── JWT ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# ─── NextAuth ───
NEXTAUTH_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"
NEXTAUTH_URL="https://appalachiangrowthsolutions.com"

# ─── Public Site URL ───
NEXT_PUBLIC_SITE_URL="https://appalachiangrowthsolutions.com"

# ─── Email (required for contact form notifications) ───
# Use the Gmail address that owns the app password.
SMTP_USER="appalachiangrowth@gmail.com"
# Use a Gmail App Password (16 characters; do not use your normal Gmail password).
SMTP_PASS=""
# Address that receives contact form submissions.
CONTACT_EMAIL="appalachiangrowth@gmail.com"
